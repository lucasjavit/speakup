# ===========================================
# SpeakUp Production Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Domain
DOMAIN=speakup.com.br

# Database
DB_NAME=speakup
DB_USERNAME=speakup
DB_PASSWORD=your-strong-database-password-here

# Security
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-minimum-64-characters-for-production-security

# Google OAuth
GOOGLE_CLIENT_ID=802273589819-i8d0v4nkqo6a92cabra1ttiabngbepo5.apps.googleusercontent.com

# Stripe (Production)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://speakup.com.br/credits/success
STRIPE_CANCEL_URL=https://speakup.com.br/credits/buy

# Claude AI (Optional - for topic generation)
CLAUDE_API_KEY=sk-ant-...
