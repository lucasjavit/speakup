# Database Configuration
POSTGRES_DB=speakup
POSTGRES_USER=speakup
POSTGRES_PASSWORD=speakup123
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# pgAdmin (development only)
PGADMIN_EMAIL=admin@speakup.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Redis Commander (development only)
REDIS_COMMANDER_PORT=8081

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT (change in production!)
JWT_SECRET=speakup-jwt-secret-key-change-this-in-production

# Google Authentication (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id

# Mail (Gmail: use App Password – https://myaccount.google.com/apppasswords)
# Without MAIL_PASSWORD, sending email will fail (auth error).
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your@gmail.com
MAIL_FROM_NAME=SpeakYou
